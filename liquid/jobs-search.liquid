<script>
$(document).ready(function() {
    {% if cb_is_referral_portal_page == 'true' %}
        {% comment %}Force redirect to url with user's country as a filter - this ensures that the user can only see jobs per their country / region (EU){% endcomment %}
        // Get the Source of Truth from your Liquid variable. This will either be the long EU string or the single User Country string
        const rawTarget = "{{ cb_location_country_params }}";

        if (!rawTarget || rawTarget.trim() === "") return;

        // Extract the key (location_country[] or location_country) and the values into an array
        const paramKey = rawTarget.match(/&?([^=]+)=/)[1];
        const targetValues = rawTarget.split('&' + paramKey + '=').filter(Boolean);

        // Get current URL state
        const url = new URL(window.location.href);
        const params = url.searchParams;
        const currentUrlValues = params.getAll(paramKey);

        // Check if the count matches AND if every target value is present in the URL
        const isMatch = (targetValues.length === currentUrlValues.length) && targetValues.every(val => currentUrlValues.includes(val));

        // If not a match, fix it and redirect
        if (!isMatch) {
            // Remove both possible versions to ensure no "leftovers"
            params.delete('location_country[]');
            params.delete('location_country');

            // Append the correct values from our Source of Truth
            targetValues.forEach(value => {
                params.append(paramKey, value);
            });

            // Redirect. .toString() handles '?' vs '&' automatically.
            window.location.search = params.toString();
        }
    {% endif %}

    {% comment %}Referral Hot Jobs section - only displays if the 'category' page has 'show-referral-hot-jobs' tag; pt. 2/2{% endcomment %}
    {% if page_object.tag_list contains 'show-referral-hot-jobs' %}
        {% comment %}Load Referral Hot Jobs section{% endcomment %}
        {% capture referral_hot_jobs_query %}location_country={{ cb_user_country }}&cf[publish_to_referral_portal]=Yes&cf[publish_to_referrals_hot_hob]=Yes{% endcapture %}
        {% capture referral_hot_jobs_url %}{{ root_url }}search/jobs/?{{ referral_hot_jobs_query }}&ns_hotjobs=1{% endcapture %}
        loadReferralHotJobs('{{ referral_hot_jobs_url }}');
    {% endif %}
});
</script>

