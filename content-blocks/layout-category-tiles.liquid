{% comment %}Capture left-side category image{% endcomment %}
{% capture page_content_formatted %}{{ page_section_content | replace_global_regex: '\n|\r','' | replace: '<p>','---' | replace: '</p>','---' }}{% endcapture %}
{% assign page_content_array = page_content_formatted | split: '---' | assign_to: 'page_element_attr' %}
{% if page_element_attr[1] contains '<img' %}
    {% capture category_tile_image %}{{ page_element_attr[1] | strip }}{% endcapture %}
    {% capture category_tile_image_wp %}<p>{{ category_tile_image }}</p>{% endcapture %}
{% endif %}
{% capture page_section_content %}{{ page_section_content | remove: category_tile_image_wp }}{% endcapture %}
{% assign category_tile_image_alt = category_tile_image | split: 'alt="' | last | split: '"' | first %}

{% capture page_content_formatted %}{{ page_section_content | replace_global_regex: '\n|\r','' | replace: '<pre>ITEM ENDITEM START</pre>','</div>------<div class="item">' | replace: '<pre>ITEM START</pre>','---<div class="item">' | replace: '<pre>ITEM END</pre>','</div>---' }}{% endcapture %}
{% assign page_content_array = page_content_formatted | split: '---' | assign_to: 'page_elements' %}

{% capture column_contents %}{% endcapture %}
{% assign row_index = 0 %}
{% capture row_index_close_tags %}
                    <div class="category-list__item columns {% if category_tile_image != blank %}large-6{% else %}medium-6 large-4{% endif %} space-foundation---">
                        <div class="category-list__item-explore padded-h-large padded-v-medium">
                            <div class="same-height-item-js--- padded-v-xlarge space-large--- show-for-large"></div>
                            <a href="/{{ current_locale.locale }}/search/jobs" class="heading-2">{{ text_category_tile_explore }} <i class="fa-solid fa-arrow-right"></i></a>
                        </div>
                    </div><!--close .category-list__item-->
                </div>
            </div>
        </div>
    </div>
</div>
{% endcapture %}

{% for page_element in page_elements %}
    {% if page_element contains '<div class="item">' %}
        {% capture column_contents %}
        {{ column_contents }}

        {% if row_index == 0 %}
            {% assign row_index = 1 %}
            <div class="row">
                <div class="column">
                    <div class="category-row row">
                        {% if category_tile_image != blank %}
                        <div class="category-column columns medium-6 large-4">
                            <div class="category-heading">
                                <div class="category-heading__image space-foundation---">
                                    {{ category_tile_image }}
                                </div>
                                <div class="category-heading__copy padded-large">
                                    <h3>{{ category_tile_image_alt }}</h3>
                                </div>
                            </div><!--close .category-heading-->
                        </div>
                        {% endif %}
                        <div class="category-column columns{% if category_tile_image != blank %} medium-6 large-8{% endif %}">
                            <div class="category-list row same-height-parent-js">
        {% endif %}

        {% capture page_element_content_formatted %}{{ page_element | replace: '<p>','---' | replace: '</p>','---' }}{% endcapture %}
        {% assign page_element_content_array = page_element_content_formatted | split: '---' | assign_to: 'page_element_attr' %}
        {% assign category_page_link = page_element_attr[1] | strip %}
        {% capture category_page_link_wp %}<p>{{ category_page_link }}</p>{% endcapture %}

        <div class="category-list__item columns {% if category_tile_image != blank %}large-6{% else %}medium-6 large-4{% endif %} space-foundation---">
            <div class="category-list__item-inner padded-medium">
                <div class="padded-small same-height-item-js">
                    {{ page_element | remove: category_page_link_wp }}
                </div>
                <p class="text-right"><a href="{{ category_page_link }}" class="branded-button-2 branded-button-normal"{% if category_page_link contains 'http' %} target="_blank"{% endif %}>{% if cb_site_type == 'external' %}{{ text_category_tile_apply }}{% elsif cb_site_type == 'internal' %}Learn More{% endif %}</a></p>
            </div>
        </div><!--close .category-list__item-->
        {% endcapture %}

    {% elsif page_element != '' %}
        {% capture column_contents %}
        {{ column_contents }}

        {% if row_index == 1 %}
            {% assign row_index = 0 %}
            {{ row_index_close_tags }}
        {% endif %}
        
        <div class="row">
            <div class="column large-6 end">
                {{ page_element }}
            </div>
        </div>
        {% endcapture %}
    {% endif %}
{% endfor %}

{% capture column_contents %}
{{ column_contents }}
{% if row_index == 1 %}
    {{ row_index_close_tags }}
{% endif %}
{% endcapture %}

{{ column_contents }}