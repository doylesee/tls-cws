{% capture page_content_formatted %}{{ page_section_content | replace_global_regex: '\n|\r','' | replace: '<pre>ITEM ENDITEM START</pre>','</div>------<div class="item">' | replace: '<pre>ITEM START</pre>','---<div class="item">' | replace: '<pre>ITEM END</pre>','</div>---' }}{% endcapture %}
{% assign page_content_array = page_content_formatted | split: '---' | assign_to: 'page_elements' %}

{% capture column_contents %}{% endcapture %}
{% assign row_index = 0 %}
{% capture row_index_close_tags %}
</div><!--close .video-testimonials.row-->
{% endcapture %}

{% for page_element in page_elements %}
	{% if page_element contains '<div class="item">' %}
		{% capture column_contents %}
		{{ column_contents }}

		{% if row_index == 0 %}
			{% assign row_index = 1 %}
			<div class="video-testimonials row">
		{% endif %}

		{% capture page_element_content_formatted %}{{ page_element | replace: '<p>','---' | replace: '</p>','---' }}{% endcapture %}
        {% assign page_element_content_array = page_element_content_formatted | split: '---' | assign_to: 'page_element_attr' %}
        {% assign item_video_obj = page_element_attr[1] | strip %}
        {% capture item_video_obj_wp %}<p>{{ item_video_obj }}</p>{% endcapture %}

        {{ item_video_obj | split: ',' | assign_to: 'item_video_attrs' }}
        {% assign item_video_url = item_video_attrs[0] %}
        {% assign item_video_label = item_video_attrs[1] %}

        <div class="video-outer video-testimonials__item columns medium-6 large-4 end">
            <div class="video-testimonials__item-inner">
                <div class="video-testimonials__item-video">
                    <video loop playsinline preload="auto" aria-label="{{ item_video_label }}">
                        <source src="{{ item_video_url }}" type="video/mp4">
                        Your browser does not support the video tag.
                    </video>
                </div>
                <div class="video-testimonials__item-text padded-h-medium space-large">
                    <div class="padded-h-small">
                        {{ page_element | remove: item_video_obj_wp }}
                    </div>
                </div>
                <button class="video-watch video-testimonials__item-watch">Watch full video</button>
            </div>
        </div><!--close .video-testimonials__item-->
		{% endcapture %}

	{% elsif page_element != '' %}
		{% capture column_contents %}
		{{ column_contents }}

		{% if row_index == 1 %}
			{% assign row_index = 0 %}
			{{ row_index_close_tags }}
		{% endif %}
		
		<div class="row">
	        <div class="column large-6 end">
	            {{ page_element }}
	        </div>
	    </div>
		{% endcapture %}
	{% endif %}
{% endfor %}

{% capture column_contents %}
{{ column_contents }}
{% if row_index == 1 %}
	{{ row_index_close_tags }}
{% endif %}
{% endcapture %}

{{ column_contents }}