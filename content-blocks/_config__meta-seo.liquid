{% comment %}
No need to add an include _config__variables, as all templates should already include that
Any variables declared on there can be used here
{% endcomment %}

{% include '/_config__page-object' %}

{% if cb_is_home_page == 'true' %}
    <!--Setting meta content for Careers Home page-->
    {% capture seo_to_index %}true{% endcapture %}
    {% capture meta_title %}{{ text_careers_at_company }}{% endcapture %}
    {% capture meta_description %}{% meta_description %}{% endcapture %}
    {% capture meta_keywords %}{% meta_keywords %}{% endcapture %}

{% elsif cb_is_category_page == 'true' %}
    <!--Setting meta content for Category pages-->
    {% capture seo_to_index %}true{% endcapture %}
    {% capture meta_title %}{{ page_object.title | html_safe }}{% endcapture %}
    {% capture meta_description %}{% if page_object.meta_description != blank %}{{ page_object.meta_description }}{% else %}{% meta_description %}{% endif %}{% endcapture %}
    {% capture meta_keywords %}{% if page_object.meta_keywords != blank %}{{ page_object.meta_keywords }}{% else %}{% meta_keywords %}{% endif %}{% endcapture %}

{% elsif cb_is_job_search == 'true' %}
    {% if request_fullpath contains '?' and request_fullpath contains '=' %}
        {% capture has_query %}true{% endcapture %}
    {% endif %}
    <!--Setting meta content for Facet pages-->
    {% if selected_facets.size == 1 and has_query != 'true' %}
        {% capture seo_to_index %}true{% endcapture %}
        {% capture meta_title %}{{ text_facet_careers }}{% endcapture %}
        {% capture meta_description %}{{ text_search_facet_careers_at_company }}{% endcapture %}
        {% capture meta_keywords %}{% meta_keywords %}{% endcapture %}
    <!--Setting meta content for Saved Jobs page-->
    {% elsif params['saved_jobs'] == '1' %}
        {% capture seo_to_index %}false{% endcapture %}
        {% capture meta_title %}{{ text_saved_jobs }} | {{ cb_company_name }}{% endcapture %}
        {% capture meta_description %}{% endcapture %}
        {% capture meta_keywords %}{% endcapture %}
    <!--Setting meta content for Job Search Results pages-->
    {% else %}
        {% if has_query == 'true' %}
            {% capture seo_to_index %}false{% endcapture %}
        {% elsif selected_facets.size > 1 %}
            {% capture seo_to_index %}false{% endcapture %}
        {% else %}
            {% capture seo_to_index %}true{% endcapture %}
        {% endif %}
        {% capture meta_title %}{{ text_job_search_results }} | {{ cb_company_name }}{% endcapture %}
        {% capture meta_description %}{{ text_search_careers_at_company }}{% endcapture %}
        {% capture meta_keywords %}{% meta_keywords %}{% endcapture %}
    {% endif %}

{% elsif job %}
    <!--Setting meta content for Job Details pages-->
    {% capture seo_to_index %}{{ job.active? }}{% endcapture %}
    {% capture meta_title %}{{ text_job_title_in_job_location | replace_global_regex: '\r?\n|\r','' | replace_global_regex: "\s+", " " }}{% endcapture %}
    {% capture meta_description %}{{ text_job_title_in_job_location | replace_global_regex: '\r?\n|\r','' | replace_global_regex: "\s+", " " }}{% endcapture %}
    {% capture meta_keywords %}{% meta_keywords %}{% endcapture %}

{% elsif page %}
    <!--Setting meta content for content pages-->
    {% if page.tag_list contains 'no-index' %}
        {% capture seo_to_index %}false{% endcapture %}
    {% else %}
        {% capture seo_to_index %}true{% endcapture %}
    {% endif %}

    {% capture meta_title %}{{ page_object.title | html_safe }}{% endcapture %}
    {% capture meta_description %}{% if page_object.meta_description != blank %}{{ page_object.meta_description }}{% else %}{% meta_description %}{% endif %}{% endcapture %}
    {% capture meta_keywords %}{% if page_object.meta_keywords != blank %}{{ page_object.meta_keywords }}{% else %}{% meta_keywords %}{% endif %}{% endcapture %}

{% endif %}

{% if root_url contains 'internal' %}
    <!--Setting meta content for non-indexable sites-->
    {% capture seo_to_index %}false{% endcapture %}
    {% capture meta_description %}{% endcapture %}
    {% capture meta_keywords %}{% endcapture %}
{% endif %}